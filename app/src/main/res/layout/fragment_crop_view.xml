<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="500dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/img_forest" />

            <com.ave.vastgui.tools.view.cropview.CropView
                android:id="@+id/crop_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crop_switch_type_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:text="@string/crop_switch_type" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crop_switch_mask_color_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:text="@string/crop_switch_mask_color" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crop_switch_stroke_color_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:text="@string/crop_switch_stroke_color" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:text="@string/crop_change_width_and_height"
            android:textStyle="bold" />

        <com.google.android.material.slider.Slider
            android:id="@+id/crop_change_width_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:value="200"
            android:valueFrom="50"
            android:valueTo="300"
            app:thumbHeight="20dp"
            app:trackHeight="10dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/crop_change_height_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:value="200"
            android:valueFrom="50"
            android:valueTo="300"
            app:thumbHeight="20dp"
            app:trackHeight="10dp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:text="@string/crop_change_size"
            android:textStyle="bold" />

        <com.google.android.material.slider.Slider
            android:id="@+id/crop_change_size_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:value="200"
            android:valueFrom="50"
            android:valueTo="300"
            app:thumbHeight="20dp"
            app:trackHeight="10dp" />
    </LinearLayout>
</ScrollView>