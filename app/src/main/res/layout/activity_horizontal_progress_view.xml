<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity.view.HorizontalProgressViewActivity">

    <com.ave.vastgui.tools.view.progress.HorizontalProgressView
        android:id="@+id/horizontal_pv"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="10dp"
        android:padding="5dp"
        app:progress_current_value="50" />

    <com.ave.vastgui.tools.view.progress.HorizontalTextProgressView
        android:id="@+id/horizontal_text_pv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp" />

    <com.ave.vastgui.tools.view.progress.LineTextProgressView
        android:id="@+id/line_text_pv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/horizontal_pv_switch_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/horizontal_pv_switch_background"
        android:layout_margin="5dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/progress_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:valueFrom="0"
        android:valueTo="100"
        app:thumbHeight="20dp"
        app:trackHeight="10dp" />

</LinearLayout>